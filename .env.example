# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=ctf_lab

# JWT Security
SECRET_KEY=change-this-to-a-random-32-character-or-longer-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google GenAI (Get key from https://makersuite.google.com/app/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# Llama.cpp MCP Agent (Admin Orchestration) - Optional
LLAMA_MODEL_PATH=models/llama-2-7b-chat.gguf
LLAMA_CTX_SIZE=2048
LLAMA_THREADS=4
LLAMA_GPU_LAYERS=0

# Server Configuration
PORT=8000
WORKERS=4
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

# API Base URL (for frontend to connect to backend)
API_BASE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cache TTL (seconds)
CACHE_TTL=300
